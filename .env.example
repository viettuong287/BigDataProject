# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.

# Chuỗi kết nối Neon (endpoint pooled, có "-pooler" trong hostname).
# Loader tự bỏ "-pooler" để dùng endpoint direct cho COPY/DDL.
NEON_DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/olist_analytics?sslmode=require
NEON_PROJECT_ID=<neon-project-id>

# Superset
SUPERSET_SECRET_KEY=<chuoi-ngau-nhien-dai>
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
